# Activar motor de reescritura
RewriteEngine On

# 1. Forzar HTTPS y www a sin-www (Canonicalización)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.rafaelverdugo\.com [NC]
RewriteRule ^(.*)$ https://rafaelverdugo.com/$1 [L,R=301]

# 2. Quitar extensión .html de la URL (Redirección externa 301)
# Si alguien accede a /contacto.html, lo manda a /contacto
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 3. Mapear URLs sin extensión a archivos .html (Reescritura interna)
# Convierte /contacto en /contacto.html y /post/post1 en /post/post1.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# Evitar listado de directorios
Options -Indexes

# Página de error 404 personalizada
ErrorDocument 404 /404.html
